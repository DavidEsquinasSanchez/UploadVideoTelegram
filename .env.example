# TeleVault - Variables de entorno (opcional)
# Las credenciales también se pueden configurar interactivamente desde la propia aplicación web.

# Token HTTP API del bot de Telegram obtenido en @BotFather (requerido)
# Ejemplo: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TG_BOT_TOKEN=

# Claves de cliente Telegram MTProto de https://my.telegram.org (opcionales para acelerar descargas y subidas)
TG_API_ID=
TG_API_HASH=
